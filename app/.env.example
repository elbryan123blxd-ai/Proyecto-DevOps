# Variables de entorno para dev local (docker compose las setea solo)
# Copiar a .env solo si corres servicios directo en tu máquina.

# DB (local en docker-compose; en AWS apuntar al endpoint RDS)
DATABASE_URL=postgresql://dbadmin:dbadmin@localhost:5432/appdb

# Worker
POLL_INTERVAL=3
PROCESSING_DELAY_MS=1500